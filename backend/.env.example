# Optional sponsor integrations. The eight planner routes ignore every variable in
# this file. Ask Gemini (`/api/chat`) reads HOKIELENS_GEMINI and GEMINI_API_KEY from
# the process environment; on Render set them in the dashboard. Never commit `.env`.
# Sponsor CLIs and `uvicorn sponsors.gateway:app` fill unset vars from `.env`.

# Public origin used in the ANS agent card and DNS TXT record.
# HOKIELENS_PUBLIC_URL=http://127.0.0.1:8000

# Ask Gemini chat, plus sponsors.gateway / `python -m sponsors.explain --gemini`.
# Both must be set. Keys stay on the server; they are never sent to the browser.
# HOKIELENS_GEMINI=0
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Live GoDaddy ANS Registration Authority (human CSR workflow). Dry-run default.
# ANS_RA_URL=
